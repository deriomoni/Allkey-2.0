# Шаблон окружения ТЕСТОВОГО стека. Скопировать в .env.test и заполнить.
# .env.test НЕ коммитим (он в .gitignore).

# База теста — своя, отдельная от прода
POSTGRES_USER=allkey_hr
POSTGRES_PASSWORD=ЗАМЕНИТЬ_на_надёжный_пароль
POSTGRES_DB=allkey_hr_test

# ОТДЕЛЬНЫЙ секретный ключ теста (НЕ такой же, как на проде!)
# Сгенерировать так:  openssl rand -hex 32
SECRET_KEY=ЗАМЕНИТЬ_сгенерировать_openssl_rand_hex_32
